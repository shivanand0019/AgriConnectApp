# Server & DB Settings
PORT=8081
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/agriconnect
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# 💳 1. PAYMENT GATEWAY (Razorpay / Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 📷 2. IMAGE UPLOAD & CLOUD STORAGE (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 📱 3. SMS OTP VERIFICATION (Twilio / Fast2SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ✉️ 4. EMAIL NOTIFICATIONS (Nodemailer / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ==================================================
# 🤖 5. GOOGLE GEMINI AI REASONING AGENT
# ==================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==================================================
# 🎙️ 6. GNANI AI MULTILINGUAL VOICE ASSISTANT
# ==================================================
# Set AI_DEMO_MODE=true for testing without active Gnani API keys
AI_DEMO_MODE=false

# Gnani Vachana Platform Credentials (for Prisma STT & Timbre TTS)
# Obtain from https://vachana.ai or https://gnani.ai
GNANI_API_KEY=your_gnani_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5

# Gnani Evon v3.3 30B Reasoning LLM
# Hugging Face or hosted vLLM inference endpoint
GNANI_EVEN_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_BASE_URL=https://api-inference.huggingface.co/models/gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=your_huggingface_token_here
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
